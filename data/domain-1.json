[{"id":"D1-0001","d":1,"o":"1.9","x":"medium","q":"A risk assessment identifies a threat with high impact but very low likelihood. Mitigating it would cost substantially more than the expected loss. Which risk response is MOST appropriate?","c":["Accept the risk and document the decision","Transfer the risk through insurance","Mitigate the risk regardless of cost","Ignore the risk since likelihood is low"],"k":""},{"id":"D1-0002","d":1,"o":"1.10","x":"easy","q":"A development team is threat modeling a new payment service and wants a structured way to enumerate potential threats against each element of the data-flow diagram. Which approach BEST supports this goal?","c":["Apply STRIDE categories to each data-flow element","Score each known vulnerability using CVSS","Commission an external penetration test","Review the enterprise risk register entries"],"k":""},{"id":"D1-0003","d":1,"o":"1.6","x":"easy","q":"An internal document states that all company laptops MUST use AES-256 full-disk encryption. Compliance is mandatory and no exceptions are listed. Which type of document is this?","c":["A security standard","A security policy","A security guideline","A security procedure"],"k":""}]
